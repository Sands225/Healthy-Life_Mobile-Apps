<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HealthyLife" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/health_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_slate</item>
        <item name="android:statusBarColor">@color/app_header_start</item>
        <item name="android:navigationBarColor">@color/app_nav_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Judul seksi di Pengaturan -->
    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Judul seksi di Beranda -->
    <style name="HomeSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MacroCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MacroValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:text">0g</item>
    </style>

    <style name="MacroLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Chip filter/segment -->
    <style name="AppChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_chip_unselected</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <!-- Field input (framework EditText) -->
    <style name="AppField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="android:textColorHint">@color/app_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
