<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Pilih Aktivitas" android:textColor="@color/app_text_secondary" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tekan lama untuk hapus" android:textColor="@color/app_text_muted" android:textSize="10sp" />
        </LinearLayout>

        <GridLayout android:id="@+id/templateGrid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="3" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Durasi" android:textColor="@color/app_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="30 menit" android:textColor="@color/health_green" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>

        <SeekBar android:id="@+id/seekDuration" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="115" android:progress="25"
            android:progressTint="@color/health_green" android:thumbTint="@color/health_green" />

        <TextView android:id="@+id/tvEstimate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Estimasi: 0 cal" android:textColor="@color/accent_teal" android:textSize="12sp" />

        <TextView android:id="@+id/btnLog" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_button_green"
            android:gravity="center" android:paddingVertical="14dp" android:text="Log Aktivitas"
            android:textColor="@color/dark_deep_navy" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
