<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_sm"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvEmoji"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#1F2D9E6B"
        android:gravity="center"
        android:text="🍚"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMacros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 cal"
            android:textColor="@color/app_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sarapan · Hari ini"
            android:textColor="@color/accent_teal"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more"
        android:scaleType="centerInside"
        android:contentDescription="Opsi" />
</LinearLayout>
