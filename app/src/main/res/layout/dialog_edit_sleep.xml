<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Durasi (jam)"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etHours"
        style="@style/AppField"
        android:layout_marginTop="6dp"
        android:hint="Jam"
        android:inputType="numberDecimal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Kualitas Tidur"
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView android:id="@+id/chipBaik" style="@style/AppChip" android:text="😴 Baik" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/chipCukup" style="@style/AppChip" android:text="🙂 Cukup" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:id="@+id/chipBuruk" style="@style/AppChip" android:text="🥱 Buruk" />
    </LinearLayout>
</LinearLayout>
