<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang 👋"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sandika"
                    android:textColor="@color/app_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tetap sehat hari ini! 🌿"
                    android:textColor="@color/health_green"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circle_glass"
                    android:src="@drawable/ic_dark_mode"
                    android:scaleType="centerInside"
                    android:contentDescription="Ubah Tema" />

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <TextView
                        android:id="@+id/tvAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@color/dark_deep_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Foto Profil" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Progress Hari Ini -->
        <TextView
            style="@style/HomeSectionTitle"
            android:text="Progress Hari Ini" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingHorizontal="20dp">

            <include android:id="@+id/ringCalories" layout="@layout/item_progress_ring"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include android:id="@+id/ringExercise" layout="@layout/item_progress_ring"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include android:id="@+id/ringSleep" layout="@layout/item_progress_ring"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <!-- Indeks BMI -->
        <TextView
            style="@style/HomeSectionTitle"
            android:text="Indeks BMI" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHomeBmi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="23.0"
                    android:textColor="@color/app_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeBmiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#262D9E6B"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Normal ✓"
                    android:textColor="@color/health_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressHomeBmi"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="60"
                android:progressDrawable="@drawable/bg_progress_track" />
        </LinearLayout>

        <!-- Tambah Cepat -->
        <TextView
            style="@style/HomeSectionTitle"
            android:text="Tambah Cepat" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingHorizontal="20dp">

            <include android:id="@+id/qaSleep" layout="@layout/item_quick_add"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <include android:id="@+id/qaFood" layout="@layout/item_quick_add"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <Space android:layout_width="12dp" android:layout_height="1dp" />
            <include android:id="@+id/qaExercise" layout="@layout/item_quick_add"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>

        <!-- Aktivitas Hari Ini -->
        <TextView
            style="@style/HomeSectionTitle"
            android:text="Aktivitas Hari Ini" />

        <LinearLayout
            android:id="@+id/activityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp" />

        <!-- Makanan Hari Ini -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Makanan Hari Ini"
                android:textColor="@color/app_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍽️ Kalori"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCaloriesSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 2000 cal"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressCalories"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout style="@style/MacroCol">
                    <TextView android:id="@+id/tvCarbs" style="@style/MacroValue" android:textColor="@color/health_green" />
                    <TextView style="@style/MacroLabel" android:text="Karbo" />
                </LinearLayout>

                <LinearLayout style="@style/MacroCol">
                    <TextView android:id="@+id/tvProtein" style="@style/MacroValue" android:textColor="@color/accent_teal" />
                    <TextView style="@style/MacroLabel" android:text="Protein" />
                </LinearLayout>

                <LinearLayout style="@style/MacroCol">
                    <TextView android:id="@+id/tvFat" style="@style/MacroValue" android:textColor="@color/accent_sage" />
                    <TextView style="@style/MacroLabel" android:text="Lemak" />
                </LinearLayout>

                <LinearLayout style="@style/MacroCol">
                    <TextView android:id="@+id/tvFiber" style="@style/MacroValue" android:textColor="@color/card_pink" />
                    <TextView style="@style/MacroLabel" android:text="Serat" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/foodContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</ScrollView>
